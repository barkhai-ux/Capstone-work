{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/_/backend/:path*",
      "destination": "https://capstone-work-1.onrender.com/:path*"
    },
    {
      "source": "/((?!_/backend).*)",
      "destination": "/index.html"
    }
  ]
}